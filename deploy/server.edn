;; Configuration for the server image. Mount your own over
;; /opt/dashboards/server.edn, or point DASHBOARDS_CONFIG elsewhere.
;; Most keys can also be given as a command-line flag (see --help);
;; :session-timeout-ms and :keep-alive-ms only in a config file.
{:title "Dashboards"

 ;; Each subdirectory with an app.clj is served at /<name>/; new ones
 ;; are picked up without a restart.
 :apps-dir "/srv/dashboards"

 ;; Reload an app when its files change. Turn off for fixed deployments.
 :reload? true

 ;; Show users a generic message instead of exception details.
 :sanitize-errors? true

 ;; Refuse new sessions beyond this many (nil for no limit).
 :max-sessions 200

 ;; End a session after this long without a heartbeat from its page.
 :session-timeout-ms 120000

 ;; On shutdown, report unhealthy on /_health for this long before
 ;; closing the event streams, so a load balancer stops sending new
 ;; tabs here first. Set it to the load balancer's health-check
 ;; interval times its unhealthy threshold, plus a little, and keep it
 ;; under the platform's stop grace period (10s for docker stop and
 ;; Cloud Run, 30s by default in Kubernetes). Leave it at 0 (the
 ;; default) with a single instance. Can also be set with
 ;; --shutdown-delay-ms or DASHBOARDS_SHUTDOWN_DELAY_MS.
 ;; :shutdown-delay-ms 5000

 ;; Apps load in the background as the server starts; /_health reports
 ;; 503 "starting" until each has loaded, failed or taken longer than
 ;; this, and nothing waits longer than this for an app. Can also be set
 ;; with --app-load-timeout-ms or DASHBOARDS_APP_LOAD_TIMEOUT_MS.
 ;; :app-load-timeout-ms 60000
 }
